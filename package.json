{
  "name": "lanka-dahan",
  "version": "1.0.0",
  "description": "Lanka Dahan — Sundara Kanda rooftop fire platformer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "art": "python3 scripts/build-art.py && python3 scripts/verify-art.py"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "phaser": "^3.80.0"
  }
}
